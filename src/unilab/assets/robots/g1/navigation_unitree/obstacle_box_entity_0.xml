<mujoco model="g1 navigation obstacle box 0">
  <!-- Mocap obstacle box entity 0 (InstinctMJ box_spec(0)):
       teleported by the navigation action term on reset. -->
  <option integrator="implicitfast" timestep="0.005" solver="Newton" iterations="10" ls_iterations="20"/>
  <worldbody>
    <body name="obstacle_box_0" mocap="true" pos="5.0 0 0.15">
      <geom name="obstacle_box_0_collision" type="box" size="0.15 0.15 0.15"
        contype="1" conaffinity="1" group="0" rgba=".65 .25 .12 1"/>
    </body>
  </worldbody>
  <keyframe>
    <key name="stand"/>
  </keyframe>
</mujoco>
