<mujoco model="g1 navigation obstacle box 1">
  <!-- Mocap obstacle box entity 1 (InstinctMJ box_spec(1)):
       teleported by the navigation action term on reset. -->
  <option integrator="implicitfast" timestep="0.005" solver="Newton" iterations="10" ls_iterations="20"/>
  <worldbody>
    <body name="obstacle_box_1" mocap="true" pos="6.0 0 0.225">
      <geom name="obstacle_box_1_collision" type="box" size="0.2 0.225 0.225"
        contype="1" conaffinity="1" group="0" rgba=".65 .25 .12 1"/>
    </body>
  </worldbody>
  <keyframe>
    <key name="stand"/>
  </keyframe>
</mujoco>
